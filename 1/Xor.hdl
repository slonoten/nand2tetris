/**
 * Exclusive-or gate:
 * if ((a and Not(b)) or (Not(a) and b)) out = 1, else out = 0
 */
CHIP Xor {
    IN a, b;
    OUT out;

    PARTS:
    Not(in=a, out=nota);
    Not(in=b, out=notb);
    Nand(a=a, b=notb, out=nandanotb);
    Nand(a=nota, b=b, out=nandnotab);
    Nand(a=nandanotb, b=nandnotab, out=out);
}