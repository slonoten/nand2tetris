/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16],inc, load, reset;
    OUT out[16];
    
    PARTS:
    Or(a=load, b=inc, out=sel0);
    Or(a=inc, b=reset, out=sel1);
    Inc16(in=pcOut , out=pcInc);
    Mux16(a=pcOut, b=pcInc, sel=inc, out=in2);
    Mux16(a=in2, b=in, sel=load, out=in3);
    Mux16(a=in3, b=false, sel=reset, out=regIn);
    Or(a=load, b=inc, out=loadOrInc);
    Or(a=loadOrInc, b=reset, out=loadReg);
    Register(in=regIn, load=loadReg, out=pcOut);
    Or16(a=pcOut, b=false, out=out);
}
